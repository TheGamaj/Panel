[TEMPLATE]
# Gamaj Panel example configuration.
# Copy to .env and adjust. Every value below is optional except GAMAJ_DATABASE_URL.

# Public gateway/listener. Gamaj listens on 616 by default.
GAMAJ_HOST = "0.0.0.0"
GAMAJ_PORT = 616
# GAMAJ_GATEWAY_ADDR = ":616"

# Gateway TLS.
# GAMAJ_SSL_CERTFILE = "/var/lib/gamaj/certs/example.com/fullchain.pem"
# GAMAJ_SSL_KEYFILE = "/var/lib/gamaj/certs/example.com/key.pem"
# GAMAJ_SSL_CA_TYPE = "public"

# Database.
# GAMAJ_DATABASE_URL = "sqlite:///db.sqlite3"
# GAMAJ_DATABASE_URL = "mysql://gamaj:password@127.0.0.1:3306/gamaj"
# GAMAJ_DATABASE_FLAVOR = "sqlite"

# MySQL/MariaDB connection (used by phpMyAdmin integration and database backups).
# GAMAJ_MYSQL_DATABASE = "gamaj"
# GAMAJ_MYSQL_USER = "gamaj"
# GAMAJ_MYSQL_PASSWORD = "change-me"
# GAMAJ_MYSQL_ROOT_PASSWORD = "change-me-too"

# phpMyAdmin integration overrides.
# GAMAJ_PHPMYADMIN_USERNAME = "gamaj"
# GAMAJ_PHPMYADMIN_PASSWORD = "change-me"

# Xray-core configuration import.
# GAMAJ_XRAY_JSON = "/var/lib/gamaj/xray_config.json"

# Binary/install metadata.
# GAMAJ_INSTALL_MODE = "binary"
# GAMAJ_SCRIPT_BIN = "/usr/local/bin/gamaj"
# GAMAJ_APP_DIR = "/opt/gamaj"
# GAMAJ_DATA_DIR = "/var/lib/gamaj"
# GAMAJ_SERVICE_NAME = "gamaj"

# Node operations and user lifecycle jobs.
# GAMAJ_NODE_OPERATIONS_POLL_INTERVAL = "15s"
# GAMAJ_NODE_USAGE_COLLECTION_INTERVAL = "30s"
# GAMAJ_NODE_USAGE_COLLECTION_LIMIT = 0
# GAMAJ_USER_LIFECYCLE_INTERVAL = "10s"
# GAMAJ_USER_LIFECYCLE_BATCH_SIZE = 500
# GAMAJ_USER_USAGE_RESET_INTERVAL = "1h"
# GAMAJ_USER_USAGE_RESET_BATCH_SIZE = 500
# GAMAJ_USER_AUTODELETE_INTERVAL = "1h"
# GAMAJ_USER_AUTODELETE_BATCH_SIZE = 500
# GAMAJ_USER_AUTODELETE_DAYS = -1
# GAMAJ_USER_AUTODELETE_INCLUDE_LIMITED = false

# API behavior.
# GAMAJ_JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440
# GAMAJ_USERS_LIST_TIMEOUT_SECONDS = 0

# Webhook notifications.
# GAMAJ_WEBHOOK_ADDRESS = "https://example.com/gamaj-hook"
# GAMAJ_WEBHOOK_SECRET = "change-me"
# GAMAJ_WEBHOOK_SEND_INTERVAL = "30s"
# GAMAJ_WEBHOOK_MAX_RETRIES = 3
# GAMAJ_WEBHOOK_RETRY_INTERVAL = "30s"

# Telegram integration.
# GAMAJ_TELEGRAM_API_BASE = "https://api.telegram.org"

# Settings, templates, certificates, and backup roots.
# GAMAJ_CERT_BASE = "/var/lib/gamaj/certs"
# GAMAJ_CONFIG_DIR = "/etc/gamaj"

# Optional GitHub-hosted sponsor manifest and its persistent local cache.
# The manifest contains assets with: id, placement (header/header_mobile/sidebar/sidebar_logo), image_url,
# valid_until (RFC3339 or YYYY-MM-DD), and optional target_url, label, and alt.
# GAMAJ_SPONSOR_MANIFEST_URL = "https://raw.githubusercontent.com/example/sponsors/main/manifest.json"
# GAMAJ_SPONSOR_CACHE_DIR = "/var/lib/gamaj/sponsor-cache"
